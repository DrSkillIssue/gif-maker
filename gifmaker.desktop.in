[Desktop Entry]
Version=1.0
Type=Application
Name=GifMaker
GenericName=Screen Recorder
Comment=Record screen to GIF, MP4, or WebM
Exec=gifmaker
Icon=camera-video
Terminal=false
Categories=AudioVideo;Video;Graphics;Recorder;GTK;
Keywords=gif;record;screen;capture;screenshot;video;
StartupNotify=true
StartupWMClass=com.gifmaker.app
Actions=screenshot-selection;screenshot-screen;screenshot-window;

[Desktop Action screenshot-selection]
Name=Screenshot (Selection)
Exec=gifmaker screenshot

[Desktop Action screenshot-screen]
Name=Screenshot (Full Screen)
Exec=gifmaker screenshot -m screen

[Desktop Action screenshot-window]
Name=Screenshot (Window)
Exec=gifmaker screenshot -m window
